{
  "schemaVersion": "0.1.0",
  "id": "multi-select-demo",
  "title": "多选选择器示例",
  "entryPageId": "multi-select-demo",
  "dependencies": {
    "components": {
      "ui.heading": "1.0.0",
      "ui.form": "1.0.0",
      "ui.select": "1.0.0",
      "ui.button": "1.0.0",
      "ui.formStatus": "1.0.0"
    },
    "actions": {}
  },
  "pages": [
    {
      "id": "multi-select-demo",
      "title": "多选选择器示例",
      "state": [],
      "forms": [
        {
          "id": "model",
          "fields": [
            {
              "id": "category",
              "path": [
                "category"
              ],
              "label": "采购类别",
              "type": "array",
              "itemType": "string",
              "initial": [],
              "rules": [
                {
                  "kind": "required",
                  "message": "请选择采购类别"
                },
                {
                  "kind": "minLength",
                  "value": 2,
                  "message": "至少选择两个类别"
                }
              ]
            },
            {
              "id": "priority",
              "path": [
                "priority"
              ],
              "label": "优先级",
              "type": "array",
              "itemType": "number",
              "initial": [
                0
              ],
              "rules": [
                {
                  "kind": "maxLength",
                  "value": 2,
                  "message": "最多选择两个优先级"
                }
              ]
            }
          ]
        }
      ],
      "children": [
        {
          "id": "heading",
          "component": "ui.heading",
          "props": {
            "title": {
              "kind": "literal",
              "value": "多选选择器"
            },
            "description": {
              "kind": "literal",
              "value": "同一个选择器支持单选 / 多选；多选使用文本或数字数组，可清空、校验和重置。"
            }
          }
        },
        {
          "id": "form",
          "component": "ui.form",
          "props": {},
          "formId": "model",
          "children": [
            {
              "id": "category",
              "component": "ui.select",
              "props": {
                "options": {
                  "kind": "literal",
                  "value": [
                    {
                      "label": "办公用品",
                      "value": "office"
                    },
                    {
                      "label": "设备采购",
                      "value": "equipment"
                    },
                    {
                      "label": "其他",
                      "value": "other"
                    }
                  ]
                },
                "hint": {
                  "kind": "literal",
                  "value": "显示名称与提交值分别配置"
                },
                "multiple": {
                  "kind": "literal",
                  "value": true
                }
              },
              "field": {
                "formId": "model",
                "fieldId": "category"
              }
            },
            {
              "id": "priority",
              "component": "ui.select",
              "props": {
                "options": {
                  "kind": "literal",
                  "value": [
                    {
                      "label": "低",
                      "value": 0
                    },
                    {
                      "label": "普通",
                      "value": 1
                    },
                    {
                      "label": "紧急",
                      "value": 2
                    },
                    {
                      "label": "暂不可用",
                      "value": 9,
                      "disabled": true
                    }
                  ]
                },
                "multiple": {
                  "kind": "literal",
                  "value": true
                }
              },
              "field": {
                "formId": "model",
                "fieldId": "priority"
              }
            },
            {
              "id": "submit",
              "component": "ui.button",
              "props": {
                "label": {
                  "kind": "literal",
                  "value": "校验并提交"
                },
                "type": {
                  "kind": "literal",
                  "value": "submit"
                }
              }
            },
            {
              "id": "reset",
              "component": "ui.button",
              "props": {
                "label": {
                  "kind": "literal",
                  "value": "重置表单"
                },
                "type": {
                  "kind": "literal",
                  "value": "reset"
                },
                "variant": {
                  "kind": "literal",
                  "value": "secondary"
                }
              }
            },
            {
              "id": "status",
              "component": "ui.formStatus",
              "props": {
                "formId": {
                  "kind": "literal",
                  "value": "model"
                }
              }
            }
          ]
        },
        {
          "id": "independent",
          "component": "ui.select",
          "props": {
            "label": {
              "kind": "literal",
              "value": "独立多选"
            },
            "value": {
              "kind": "literal",
              "value": []
            },
            "multiple": {
              "kind": "literal",
              "value": true
            },
            "options": {
              "kind": "literal",
              "value": [
                {
                  "label": "数字零",
                  "value": 0
                },
                {
                  "label": "文本零",
                  "value": "0"
                },
                {
                  "label": "暂不可用",
                  "value": "disabled",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
