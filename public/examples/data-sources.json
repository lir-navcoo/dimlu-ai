{
  "schemaVersion": "0.1.0",
  "id": "dimlu.data-sources",
  "title": "数据源内核示例",
  "entryPageId": "query",
  "dependencies": {
    "components": {
      "ui.heading": "1.0.0",
      "ui.input": "1.0.0",
      "ui.button": "1.0.0",
      "ui.table": "1.0.0",
      "ui.text": "1.0.0"
    },
    "actions": {
      "data.execute": "1.0.0",
      "state.set": "1.0.0"
    },
    "transports": {
      "demo.peopleQuery": "1.0.0"
    }
  },
  "pages": [
    {
      "id": "query",
      "title": "数据源查询",
      "state": [
        {
          "id": "query",
          "type": "string",
          "initial": ""
        }
      ],
      "dataSources": [
        {
          "id": "people",
          "kind": "query",
          "transport": "demo.peopleQuery",
          "input": {
            "query": {
              "kind": "stateRef",
              "stateId": "query"
            }
          },
          "initial": {
            "rows": [],
            "total": 0
          }
        }
      ],
      "onEnter": [
        {
          "id": "enter-people",
          "action": "data.execute",
          "input": {
            "sourceId": {
              "kind": "literal",
              "value": "people"
            }
          }
        }
      ],
      "children": [
        {
          "id": "heading",
          "component": "ui.heading",
          "props": {
            "title": {
              "kind": "literal",
              "value": "数据源查询"
            },
            "description": {
              "kind": "literal",
              "value": "仅预览时进入页面查询；修改条件后显式点击查询。输入“失败”可体验错误与重试。"
            }
          }
        },
        {
          "id": "query-input",
          "component": "ui.input",
          "props": {
            "label": {
              "kind": "literal",
              "value": "查询条件"
            },
            "value": {
              "kind": "stateRef",
              "stateId": "query"
            },
            "placeholder": {
              "kind": "literal",
              "value": "姓名或部门"
            }
          },
          "on": {
            "onChange": [
              {
                "id": "update-query",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "query"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event.target.value"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "query-button",
          "component": "ui.button",
          "props": {
            "label": {
              "kind": "literal",
              "value": "查询记录"
            }
          },
          "on": {
            "onClick": [
              {
                "id": "query-people",
                "action": "data.execute",
                "input": {
                  "sourceId": {
                    "kind": "literal",
                    "value": "people"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "query-error",
          "component": "ui.text",
          "props": {
            "value": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.people.error ? sources.people.error.message : \"\""
            },
            "tone": {
              "kind": "literal",
              "value": "muted"
            }
          }
        },
        {
          "id": "query-table",
          "component": "ui.table",
          "props": {
            "data": {
              "kind": "dataRef",
              "sourceId": "people",
              "path": [
                "rows"
              ]
            },
            "columns": {
              "kind": "literal",
              "value": [
                {
                  "key": "name",
                  "title": "姓名"
                },
                {
                  "key": "department",
                  "title": "部门"
                }
              ]
            },
            "rowKey": {
              "kind": "literal",
              "value": "id"
            },
            "loading": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.people.loading"
            },
            "paginate": {
              "kind": "literal",
              "value": false
            }
          }
        }
      ]
    }
  ]
}
