{
  "schemaVersion": "0.1.0",
  "id": "dimlu.server-records",
  "title": "服务端列表与保存刷新",
  "entryPageId": "records",
  "dependencies": {
    "components": {
      "ui.heading": "1.0.0",
      "ui.layout": "1.0.0",
      "ui.input": "1.0.0",
      "ui.number": "1.0.0",
      "ui.button": "1.0.0",
      "ui.table": "1.0.0",
      "ui.pagination": "1.0.0",
      "ui.drawer": "1.0.0",
      "ui.form": "1.0.0",
      "ui.formStatus": "1.0.0",
      "ui.alert": "1.0.0",
      "ui.text": "1.0.0"
    },
    "actions": {
      "state.set": "1.0.0",
      "data.execute": "1.0.0",
      "form.reset": "1.0.0",
      "form.setValues": "1.0.0",
      "demo.saveRecordOnce": "1.0.0",
      "ui.notify": "1.0.0"
    },
    "transports": {
      "demo.recordsQuery": "1.0.0",
      "demo.recordSave": "1.0.0"
    }
  },
  "pages": [
    {
      "id": "records",
      "title": "服务端记录管理",
      "state": [
        {
          "id": "query",
          "type": "string",
          "initial": ""
        },
        {
          "id": "page",
          "type": "number",
          "initial": 1
        },
        {
          "id": "pageSize",
          "type": "number",
          "initial": 5
        },
        {
          "id": "sortKey",
          "type": "string",
          "initial": ""
        },
        {
          "id": "sortDirection",
          "type": "string",
          "initial": ""
        },
        {
          "id": "selectedId",
          "type": "string",
          "initial": ""
        },
        {
          "id": "drawerOpen",
          "type": "boolean",
          "initial": false
        },
        {
          "id": "saveCommitted",
          "type": "boolean",
          "initial": false
        }
      ],
      "forms": [
        {
          "id": "edit",
          "fields": [
            {
              "id": "recordId",
              "path": [
                "id"
              ],
              "label": "记录 ID",
              "type": "string",
              "initial": ""
            },
            {
              "id": "name",
              "path": [
                "name"
              ],
              "label": "姓名",
              "type": "string",
              "initial": "",
              "disabled": {
                "kind": "expression",
                "language": "javascript",
                "source": "state.saveCommitted"
              },
              "rules": [
                {
                  "kind": "required",
                  "message": "请填写姓名"
                }
              ]
            },
            {
              "id": "department",
              "path": [
                "department"
              ],
              "label": "部门",
              "type": "string",
              "initial": "",
              "disabled": {
                "kind": "expression",
                "language": "javascript",
                "source": "state.saveCommitted"
              },
              "rules": [
                {
                  "kind": "required",
                  "message": "请填写部门"
                }
              ]
            },
            {
              "id": "amount",
              "path": [
                "amount"
              ],
              "label": "金额",
              "type": "number",
              "initial": 0,
              "disabled": {
                "kind": "expression",
                "language": "javascript",
                "source": "state.saveCommitted"
              },
              "rules": [
                {
                  "kind": "required",
                  "message": "请填写金额"
                },
                {
                  "kind": "min",
                  "value": 0,
                  "message": "金额不能小于零"
                }
              ]
            }
          ]
        }
      ],
      "dataSources": [
        {
          "id": "records",
          "kind": "query",
          "transport": "demo.recordsQuery",
          "input": {
            "query": {
              "kind": "stateRef",
              "stateId": "query"
            },
            "page": {
              "kind": "stateRef",
              "stateId": "page"
            },
            "pageSize": {
              "kind": "stateRef",
              "stateId": "pageSize"
            },
            "sortKey": {
              "kind": "stateRef",
              "stateId": "sortKey"
            },
            "sortDirection": {
              "kind": "stateRef",
              "stateId": "sortDirection"
            }
          },
          "initial": {
            "items": [],
            "total": 0,
            "page": 1,
            "pageSize": 5,
            "sort": null
          }
        },
        {
          "id": "saveRecord",
          "kind": "mutation",
          "transport": "demo.recordSave",
          "input": {
            "id": {
              "kind": "stateRef",
              "stateId": "selectedId"
            },
            "values": {
              "kind": "formValues",
              "formId": "edit"
            }
          },
          "initial": {
            "id": ""
          }
        }
      ],
      "onEnter": [
        {
          "id": "enter-query",
          "action": "data.execute",
          "input": {
            "sourceId": {
              "kind": "literal",
              "value": "records"
            }
          }
        },
        {
          "id": "enter-page",
          "action": "state.set",
          "input": {
            "stateId": {
              "kind": "literal",
              "value": "page"
            },
            "value": {
              "kind": "dataRef",
              "sourceId": "records",
              "path": [
                "page"
              ]
            }
          }
        },
        {
          "id": "enter-size",
          "action": "state.set",
          "input": {
            "stateId": {
              "kind": "literal",
              "value": "pageSize"
            },
            "value": {
              "kind": "dataRef",
              "sourceId": "records",
              "path": [
                "pageSize"
              ]
            }
          }
        }
      ],
      "children": [
        {
          "id": "heading",
          "component": "ui.heading",
          "props": {
            "title": {
              "kind": "literal",
              "value": "服务端记录管理"
            },
            "description": {
              "kind": "literal",
              "value": "查询、分页、排序由本地 mock 服务执行。搜索“查询失败”验证重试；编辑姓名为“保存失败”或“刷新失败”验证两类错误。"
            }
          }
        },
        {
          "id": "query-filter",
          "component": "ui.input",
          "props": {
            "label": {
              "kind": "literal",
              "value": "搜索姓名或部门"
            },
            "value": {
              "kind": "stateRef",
              "stateId": "query"
            },
            "placeholder": {
              "kind": "literal",
              "value": "输入后点击搜索，不自动请求"
            }
          },
          "on": {
            "onChange": [
              {
                "id": "update-filter",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "query"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event.target.value"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "query-actions",
          "component": "ui.layout",
          "props": {
            "variant": {
              "kind": "literal",
              "value": "row"
            }
          },
          "children": [
            {
              "id": "search-button",
              "component": "ui.button",
              "props": {
                "label": {
                  "kind": "literal",
                  "value": "搜索"
                }
              },
              "on": {
                "onClick": [
                  {
                    "id": "search-first-page",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "page"
                      },
                      "value": {
                        "kind": "literal",
                        "value": 1
                      }
                    }
                  },
                  {
                    "id": "search-query",
                    "action": "data.execute",
                    "input": {
                      "sourceId": {
                        "kind": "literal",
                        "value": "records"
                      }
                    }
                  },
                  {
                    "id": "search-page",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "page"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "page"
                        ]
                      }
                    }
                  },
                  {
                    "id": "search-size",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "pageSize"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "pageSize"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "clear-button",
              "component": "ui.button",
              "props": {
                "label": {
                  "kind": "literal",
                  "value": "清空筛选"
                }
              },
              "on": {
                "onClick": [
                  {
                    "id": "clear-filter-value",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "query"
                      },
                      "value": {
                        "kind": "literal",
                        "value": ""
                      }
                    }
                  },
                  {
                    "id": "clear-first-page",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "page"
                      },
                      "value": {
                        "kind": "literal",
                        "value": 1
                      }
                    }
                  },
                  {
                    "id": "clear-query",
                    "action": "data.execute",
                    "input": {
                      "sourceId": {
                        "kind": "literal",
                        "value": "records"
                      }
                    }
                  },
                  {
                    "id": "clear-page",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "page"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "page"
                        ]
                      }
                    }
                  },
                  {
                    "id": "clear-size",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "pageSize"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "pageSize"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "query-status",
          "component": "ui.text",
          "props": {
            "value": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.records.loading ? \"正在查询…\" : \"共 \" + sources.records.data.total + \" 条记录\""
            },
            "tone": {
              "kind": "literal",
              "value": "muted"
            }
          }
        },
        {
          "id": "records-table",
          "component": "ui.table",
          "props": {
            "data": {
              "kind": "dataRef",
              "sourceId": "records",
              "path": [
                "items"
              ]
            },
            "columns": {
              "kind": "literal",
              "value": [
                {
                  "key": "name",
                  "title": "姓名",
                  "sortable": true
                },
                {
                  "key": "department",
                  "title": "部门",
                  "sortable": true
                },
                {
                  "key": "amount",
                  "title": "金额",
                  "sortable": true,
                  "align": "right"
                }
              ]
            },
            "rowKey": {
              "kind": "literal",
              "value": "id"
            },
            "sort": {
              "kind": "dataRef",
              "sourceId": "records",
              "path": [
                "sort"
              ]
            },
            "sortMode": {
              "kind": "literal",
              "value": "server"
            },
            "paginate": {
              "kind": "literal",
              "value": false
            },
            "loading": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.records.loading"
            },
            "error": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.records.error ? sources.records.error.message : \"\""
            }
          },
          "on": {
            "onSortChange": [
              {
                "id": "sort-key",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "sortKey"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event ? event.key : \"\""
                  }
                }
              },
              {
                "id": "sort-direction",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "sortDirection"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event ? event.direction : \"\""
                  }
                }
              },
              {
                "id": "sort-first-page",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "page"
                  },
                  "value": {
                    "kind": "literal",
                    "value": 1
                  }
                }
              },
              {
                "id": "sort-query",
                "action": "data.execute",
                "input": {
                  "sourceId": {
                    "kind": "literal",
                    "value": "records"
                  }
                }
              },
              {
                "id": "sort-page",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "page"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "page"
                    ]
                  }
                }
              },
              {
                "id": "sort-size",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "pageSize"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "pageSize"
                    ]
                  }
                }
              }
            ],
            "onRetry": [
              {
                "id": "retry-list-query",
                "action": "data.execute",
                "input": {
                  "sourceId": {
                    "kind": "literal",
                    "value": "records"
                  }
                }
              },
              {
                "id": "retry-list-page",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "page"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "page"
                    ]
                  }
                }
              },
              {
                "id": "retry-list-size",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "pageSize"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "pageSize"
                    ]
                  }
                }
              }
            ]
          },
          "slots": {
            "actions": {
              "params": [
                "row",
                "index"
              ],
              "children": [
                {
                  "id": "edit-record",
                  "component": "ui.button",
                  "props": {
                    "label": {
                      "kind": "literal",
                      "value": "编辑"
                    },
                    "disabled": {
                      "kind": "expression",
                      "language": "javascript",
                      "source": "forms.edit.isSubmitting"
                    }
                  },
                  "on": {
                    "onClick": [
                      {
                        "id": "edit-marker",
                        "action": "state.set",
                        "input": {
                          "stateId": {
                            "kind": "literal",
                            "value": "saveCommitted"
                          },
                          "value": {
                            "kind": "literal",
                            "value": false
                          }
                        }
                      },
                      {
                        "id": "edit-id",
                        "action": "state.set",
                        "input": {
                          "stateId": {
                            "kind": "literal",
                            "value": "selectedId"
                          },
                          "value": {
                            "kind": "expression",
                            "language": "javascript",
                            "source": "scope.row.id"
                          }
                        }
                      },
                      {
                        "id": "edit-reset",
                        "action": "form.reset",
                        "input": {
                          "formId": {
                            "kind": "literal",
                            "value": "edit"
                          }
                        }
                      },
                      {
                        "id": "edit-prefill",
                        "action": "form.setValues",
                        "input": {
                          "formId": {
                            "kind": "literal",
                            "value": "edit"
                          },
                          "values": {
                            "kind": "expression",
                            "language": "javascript",
                            "source": "scope.row"
                          }
                        }
                      },
                      {
                        "id": "edit-open",
                        "action": "state.set",
                        "input": {
                          "stateId": {
                            "kind": "literal",
                            "value": "drawerOpen"
                          },
                          "value": {
                            "kind": "literal",
                            "value": true
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "id": "records-pagination",
          "component": "ui.pagination",
          "props": {
            "page": {
              "kind": "stateRef",
              "stateId": "page"
            },
            "pageSize": {
              "kind": "stateRef",
              "stateId": "pageSize"
            },
            "total": {
              "kind": "dataRef",
              "sourceId": "records",
              "path": [
                "total"
              ]
            },
            "disabled": {
              "kind": "expression",
              "language": "javascript",
              "source": "sources.records.loading"
            }
          },
          "on": {
            "onPaginationChange": [
              {
                "id": "pagination-request-page",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "page"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event.page"
                  }
                }
              },
              {
                "id": "pagination-request-size",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "pageSize"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event.pageSize"
                  }
                }
              },
              {
                "id": "pagination-query",
                "action": "data.execute",
                "input": {
                  "sourceId": {
                    "kind": "literal",
                    "value": "records"
                  }
                }
              },
              {
                "id": "pagination-page",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "page"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "page"
                    ]
                  }
                }
              },
              {
                "id": "pagination-size",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "pageSize"
                  },
                  "value": {
                    "kind": "dataRef",
                    "sourceId": "records",
                    "path": [
                      "pageSize"
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "id": "edit-drawer",
          "component": "ui.drawer",
          "props": {
            "title": {
              "kind": "literal",
              "value": "编辑服务端记录"
            },
            "description": {
              "kind": "literal",
              "value": "保存成功后只刷新列表；刷新失败可以单独重试，无需再次保存。"
            },
            "open": {
              "kind": "stateRef",
              "stateId": "drawerOpen"
            },
            "triggerLabel": {
              "kind": "literal",
              "value": "继续当前编辑"
            },
            "showFooter": {
              "kind": "literal",
              "value": false
            },
            "width": {
              "kind": "literal",
              "value": 460
            }
          },
          "on": {
            "onOpenChange": [
              {
                "id": "drawer-toggle",
                "action": "state.set",
                "input": {
                  "stateId": {
                    "kind": "literal",
                    "value": "drawerOpen"
                  },
                  "value": {
                    "kind": "expression",
                    "language": "javascript",
                    "source": "event"
                  }
                }
              }
            ]
          },
          "children": [
            {
              "id": "refresh-warning",
              "component": "ui.alert",
              "when": {
                "kind": "expression",
                "language": "javascript",
                "source": "state.saveCommitted && !!sources.records.error"
              },
              "props": {
                "title": {
                  "kind": "literal",
                  "value": "保存已完成，仅列表刷新失败"
                },
                "description": {
                  "kind": "literal",
                  "value": "记录已经写入服务，请点击“仅重试刷新”，不会再次保存。"
                },
                "tone": {
                  "kind": "literal",
                  "value": "warning"
                }
              }
            },
            {
              "id": "retry-refresh",
              "component": "ui.button",
              "props": {
                "label": {
                  "kind": "literal",
                  "value": "仅重试刷新"
                },
                "disabled": {
                  "kind": "expression",
                  "language": "javascript",
                  "source": "sources.records.loading || forms.edit.isSubmitting"
                }
              },
              "on": {
                "onClick": [
                  {
                    "id": "retry-saved-refresh-query",
                    "action": "data.execute",
                    "input": {
                      "sourceId": {
                        "kind": "literal",
                        "value": "records"
                      }
                    }
                  },
                  {
                    "id": "retry-saved-refresh-page",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "page"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "page"
                        ]
                      }
                    }
                  },
                  {
                    "id": "retry-saved-refresh-size",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "pageSize"
                      },
                      "value": {
                        "kind": "dataRef",
                        "sourceId": "records",
                        "path": [
                          "pageSize"
                        ]
                      }
                    }
                  },
                  {
                    "id": "retry-saved-refresh-notice",
                    "action": "ui.notify",
                    "input": {
                      "title": {
                        "kind": "literal",
                        "value": "记录已保存，列表已刷新"
                      },
                      "tone": {
                        "kind": "literal",
                        "value": "success"
                      }
                    }
                  },
                  {
                    "id": "retry-saved-refresh-close",
                    "action": "state.set",
                    "input": {
                      "stateId": {
                        "kind": "literal",
                        "value": "drawerOpen"
                      },
                      "value": {
                        "kind": "literal",
                        "value": false
